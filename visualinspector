# hsn_visual_inspector.py

def visual_registry_inspector(registry):
    """
    Prints a clean ASCII table of all registered HSN modules.
    """

    modules = registry.list_modules()

    print("\n" + "=" * 60)
    print("HSN MODULE REGISTRY".center(60))
    print("=" * 60)

    print(f"{'MODULE NAME':<20} | DESCRIPTION")
    print("-" * 60)

    for name, desc in modules.items():
        print(f"{name:<20} | {desc}")

    print("=" * 60 + "\n")
